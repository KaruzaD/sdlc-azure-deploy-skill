# Non-secret inputs for bootstrap.sh, written from .azure-deploy/state.json. Never put a secret here.
SUBSCRIPTION_ID=
LOCATION=canadacentral
GITHUB_REPO=owner/repo
GH_ENVIRONMENT=dev
BOOTSTRAP_RG=rg-example-bootstrap
IDENTITY_NAME=id-example-deploy
# Only when attaching to an existing SRE agent: its full resource ID.
SRE_AGENT_ID=
# Space-separated names of secrets to generate straight into the GitHub environment.
GENERATED_SECRETS="POSTGRES_ADMIN_PASSWORD"
# One "role|scope|condition" per line, from the approved plan. Leave the condition empty if none.
# Contributor for the pipeline identity is allowed in sandbox only, as a recorded R27 deviation.
ROLE_ASSIGNMENTS="
Reader|/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example|
"
